FROM fedora:44@sha256:15da97ed9aa94dd3d92c3925eb89520f6c80e07ea7ee24cba848d1f8b6912b3e
RUN dnf -y install targetd-0.10.4-11.fc44 lvm2 && dnf clean all
RUN printf 'activation {\n  udev_sync = 0\n  udev_rules = 0\n}\n' > /etc/lvm/lvm.conf
CMD ["/usr/bin/targetd"]
